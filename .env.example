# Copy to `.env` as needed. Paths are relative to the API working directory (`/app` in Docker).
# Docker Compose reads `.env` in this folder for ${VAR:-default} substitution in docker-compose.yml.
# For local Python (uvicorn, scripts importing `src.utils.config`), variables are loaded from `.env`
# via python-dotenv when that file exists (existing shell env vars are not overwritten).

NOVALM_CHECKPOINT=artifacts/checkpoints/best.pt
NOVALM_SP_MODEL=artifacts/tokenizers/tokenizer.model
NOVALM_CHUNKS_JSON=data/index/chunks.json

# Compose only: host port mapped to container port 8080 (default 8080 if unset).
# NOVALM_HOST_PORT=8080
